#include <winver.h>
#include "../include/bzfile_version.h"

// Keep Explorer/file-version metadata tied to the same semantic version used
// by the native export and release tag validation.
VS_VERSION_INFO VERSIONINFO
 FILEVERSION BZFILE_VERSION_TUPLE
 PRODUCTVERSION BZFILE_VERSION_TUPLE
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
#ifdef _DEBUG
 FILEFLAGS VS_FF_DEBUG
#else
 FILEFLAGS 0x0L
#endif
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_DLL
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Battlezone 98 Redux community project\0"
            VALUE "FileDescription", "bzfile Lua file I/O and update library\0"
            VALUE "FileVersion", BZFILE_VERSION_FILE_STRING
            VALUE "InternalName", "bzfile\0"
            VALUE "OriginalFilename", "bzfile.dll\0"
            VALUE "ProductName", "bzfile\0"
            VALUE "ProductVersion", BZFILE_VERSION_FILE_STRING
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
