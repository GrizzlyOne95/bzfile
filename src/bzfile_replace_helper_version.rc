#include <winver.h>
#include "../include/bzfile_version.h"

// The helper is released as part of the same transactional bzfile package, so
// it intentionally shares the package semantic version with bzfile.dll.
VS_VERSION_INFO VERSIONINFO
 FILEVERSION BZFILE_VERSION_TUPLE
 PRODUCTVERSION BZFILE_VERSION_TUPLE
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
#ifdef _DEBUG
 FILEFLAGS VS_FF_DEBUG
#else
 FILEFLAGS 0x0L
#endif
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Battlezone 98 Redux community project\0"
            VALUE "FileDescription", "bzfile deferred replacement helper\0"
            VALUE "FileVersion", BZFILE_VERSION_FILE_STRING
            VALUE "InternalName", "bzfile_replace_helper\0"
            VALUE "OriginalFilename", "bzfile_replace_helper.exe\0"
            VALUE "ProductName", "bzfile\0"
            VALUE "ProductVersion", BZFILE_VERSION_FILE_STRING
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
